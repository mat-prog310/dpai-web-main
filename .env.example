# =============================================================================
# CONFIGURATION RAILWAY - VARIABLES D'ENVIRONNEMENT SÉCURISÉES
# =============================================================================
# 
# ⚠️  IMPORTANT: NE JAMAIS COMMITER CE FICHIER AVEC DES VALEURS RÉELLES !
# 
# Sur Railway, configurez ces variables dans l'onglet "Variables" de votre projet.
# Ces variables sont injectées automatiquement dans process.env
#
# =============================================================================

# -----------------------------------------------
# CONFIGURATION FIREBASE (Clés API sensibles)
# -----------------------------------------------
# Ces clés sont utilisées côté serveur et NE SONT PAS exposées au client

# Clé API Firebase
FIREBASE_API_KEY=your_firebase_api_key_here

# Domaine d'authentification Firebase
FIREBASE_AUTH_DOMAIN=dpai-8be62.firebaseapp.com

# ID du projet Firebase
FIREBASE_PROJECT_ID=dpai-8be62

# Bucket de stockage Firebase
FIREBASE_STORAGE_BUCKET=dpai-8be62.firebasestorage.app

# ID de l'expéditeur de messages Firebase
FIREBASE_MESSAGING_SENDER_ID=829160806332

# ID de l'application Firebase
FIREBASE_APP_ID=1:829160806332:web:125fd1c706ca97a0fcbdb9

# ID de mesure Firebase (Google Analytics)
FIREBASE_MEASUREMENT_ID=G-R3QVVF35GB

# -----------------------------------------------
# CONFIGURATION DU SERVEUR
# -----------------------------------------------

# Port du serveur (Railway l'assigne automatiquement)
PORT=8080

# Environnement (development, production, staging)
NODE_ENV=production

# -----------------------------------------------
# CONFIGURATION STRIPE (si applicable)
# -----------------------------------------------

# Clé secrète Stripe (NE JAMAIS exposer au client)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Clé publique Stripe (peut être utilisée côté client)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# Webhook secret Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# -----------------------------------------------
# CONFIGURATION DE SÉCURITÉ
# -----------------------------------------------

# Origines autorisées pour CORS (séparées par des virgules)
ALLOWED_ORIGINS=https://dpai-strategy.com,https://www.dpai-strategy.com

# -----------------------------------------------
# CONFIGURATION DE LA BASE DE DONNÉES
# -----------------------------------------------

# URL de connexion à la base de données (si applicable)
DATABASE_URL=your_database_connection_string

# =============================================================================
# INSTRUCTIONS POUR RAILWAY
# =============================================================================
#
# 1. Allez dans votre tableau de bord Railway
# 2. Sélectionnez votre projet DPAI
# 3. Allez dans l'onglet "Variables"
# 4. Cliquez sur "New Variable"
# 5. Ajoutez chaque variable ci-dessus avec ses valeurs réelles
# 6. Assurez-vous que les variables sensibles sont marquées comme "Hidden"
#
# Pour les clés Firebase, vous pouvez les trouver dans:
# - Console Firebase > Votre projet > Paramètres du projet > Clés API
#
# =============================================================================

# -----------------------------------------------
# EXEMPLE DE CONFIGURATION POUR LE DEVELOPPEMENT LOCAL
# -----------------------------------------------
# Pour tester localement, créez un fichier .env (dans .gitignore)
# avec les mêmes variables mais avec des valeurs de test.

# Exemple pour .env (LOCAL DEVELOPMENT ONLY):
# FIREBASE_API_KEY=AIzaSyDowkBbuxpYbpkMqdXyrxXGgk7FHxy7m68
# FIREBASE_AUTH_DOMAIN=dpai-8be62.firebaseapp.com
# ... etc

# =============================================================================